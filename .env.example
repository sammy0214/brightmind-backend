# Deployment region: one deployment per data-residency region.
# Allowed: africa | us_uk_ca_au | eu_br_in
REGION=africa

# Regional Postgres (each region has its OWN database; never share across regions)
DATABASE_URL=postgresql+asyncpg://brightmind:brightmind@localhost:5432/brightmind
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
PARENT_TOKEN_MINUTES=60
CHILD_TOKEN_MINUTES=720

# Leave blank to run with the offline dev tutor (no API calls)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
USE_LLM_MODERATION=true

CONSENT_POLICY_VERSION=2026-01
STORAGE_DIR=./data
AUTO_CREATE_TABLES=true
